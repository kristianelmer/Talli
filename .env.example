SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-side-only-never-browser
# Canonical public origin used for auth email links (confirmation, reset).
# Set to your production domain so links never point at localhost.
SITE_URL=https://talli.no
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
# Backend-only company-access connection. Provision a dedicated login principal
# that can SET ROLE only to the restricted company_access executors;
# never expose this URL to Next.js or a browser bundle.
TALLI_COMPANY_ACCESS_DATABASE_URL=postgresql://talli_company_access_backend:your-password@db.your-project-ref.supabase.co:5432/postgres
# Separate SET-only backend principals. Neither URL may use service_role or a
# migration/provisioner login, and neither may enter a browser bundle.
TALLI_MARKETING_MEASUREMENT_DATABASE_URL=postgresql://talli_marketing_measurement_backend:your-password@db.your-project-ref.supabase.co:5432/postgres
TALLI_VALIDATION_OBSERVATION_DATABASE_URL=postgresql://talli_validation_observation_backend:your-password@db.your-project-ref.supabase.co:5432/postgres
# Full-launch safe state. Invited observation additionally requires the exact
# prelaunch product mode and a separately approved database run/entitlement.
TALLI_PRODUCT_MODE=full-launch
TALLI_VALIDATION_OBSERVATION_MODE=off
TALLI_VALIDATION_PILOT_ENTITLEMENT_ID=
TALLI_VALIDATION_APPROVED_RUN_ID=
TALLI_VALIDATION_OBSERVATION_STARTS_AT=
TALLI_VALIDATION_OBSERVATION_EXPIRES_AT=
TALLI_VALIDATION_PARTICIPANT_INFORMATION_SHA256=
TALLI_VALIDATION_SUBJECT_BINDING_KEY=
# Optional marketing collection remains fail-closed until an approved notice
# release with these exact values is provisioned in the private database.
TALLI_MARKETING_MEASUREMENT_INTERNAL_KEY=
TALLI_MARKETING_PRIVACY_NOTICE_VERSION=unapproved
TALLI_MARKETING_PRIVACY_NOTICE_SHA256=unapproved
TALLI_RELEASE_SHA256=unapproved
# Public Brønnøysundregistrene endpoint; HTTP is accepted only for loopback tests.
BRREG_BASE_URL=https://data.brreg.no
BRREG_TIMEOUT_SECONDS=5
TALLI_PYTHON_BIN=/srv/talli/.venv/bin/python
TALLI_CORPORATE_DOCUMENTS_ENABLED=false
# Annual billing remains off unless all designated Vipps merchant-test settings
# are supplied. This mode never enables production Vipps or filing readiness.
TALLI_ANNUAL_BILLING_MODE=off
TALLI_VIPPS_MT_MERCHANT_SERIAL_NUMBER=535717
TALLI_VIPPS_MT_CLIENT_ID=
TALLI_VIPPS_MT_CLIENT_SECRET=
TALLI_VIPPS_MT_SUBSCRIPTION_KEY=
# Exact HTTPS origin(s) verified from the designated MT confirmation response,
# comma-separated, with no trailing slash. Never infer an origin from production.
TALLI_VIPPS_MT_CONFIRMATION_ORIGINS=
TALLI_VIPPS_MT_WEBHOOK_CALLBACK_URL=
TALLI_VIPPS_MT_WEBHOOK_SECRET=
# Separate backend login with SET ROLE annual_notification_executor only;
# never use a migration/service-role principal or expose this URL to the browser.
TALLI_ANNUAL_NOTIFICATION_DATABASE_URL=
# Separate standalone checkout observation worker; this does not start a task
# in FastAPI or enable new checkouts. Its login must be independently registered
# for vipps-mt/535717 and SET only annual_checkout_observer_executor.
TALLI_ANNUAL_CHECKOUT_RECONCILIATION_MODE=off
TALLI_ANNUAL_CHECKOUT_RECONCILIATION_DATABASE_URL=
# Server-to-server callback transport key shared only by web server/backend
# (at least 32 random bytes). Never NEXT_PUBLIC, a provider key, or logged.
TALLI_AUTHORITY_CALLBACK_INTERNAL_KEY=
# Backend-only authority settings. RF production is deny-by-default; configuring
# these is not authorization to activate it. Do not put provider keys in web env.
TALLI_RF1086_PRODUCTION_ENABLED=false
TALLI_PROD_MASKINPORTEN_CLIENT_ID=
TALLI_PROD_MASKINPORTEN_KEY_ID=
TALLI_PROD_MASKINPORTEN_PRIVATE_KEY_PEM=
TALLI_PROD_RF1086_SCOPE=skatteetaten:innrapporteringaksjonaerregisteroppgave
