{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talli.no/schemas/architecture/compatibility.schema.json",
  "type": "object",
  "required": ["schemaVersion", "exceptions"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "owner", "creationIssue", "removalIssue", "scopes", "approvedBy", "approvedAt", "releaseLimit", "expiresAt", "removalCondition"],
        "properties": {
          "id": { "type": "string", "pattern": "^compat-" },
          "owner": { "type": "string" },
          "creationIssue": { "type": "string", "pattern": "^#[0-9]+$" },
          "removalIssue": { "type": "string", "pattern": "^#[0-9]+$" },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "required": ["path", "rule", "resource", "operation"],
              "properties": {
                "path": { "type": "string", "pattern": "^apps/web/[^\\s]+$" },
                "rule": { "enum": ["direct-web-business-persistence", "direct-business-fetch", "generated-client-deep-import"] },
                "resource": { "type": "string", "pattern": "^(table|rpc|storage|url|module):[^\\s]+$" },
                "operation": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(?:[.#][A-Za-z_$][A-Za-z0-9_$]*)*$" }
              },
              "additionalProperties": false
            }
          },
          "approvedBy": { "type": "string", "minLength": 1 },
          "approvedAt": { "type": "string", "format": "date-time" },
          "releaseLimit": { "const": "next-stable-customer-ready-release" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "removalCondition": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
