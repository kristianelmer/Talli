{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talli.no/schemas/architecture/database-catalog.schema.json",
  "type": "object",
  "required": ["schemaVersion", "source", "ownershipPolicy", "compatibilityAdapterRegistry", "tables"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "source": { "const": "supabase/migrations" },
    "ownershipPolicy": { "const": "capability owners are authoritative" },
    "compatibilityAdapterRegistry": { "const": "architecture/compatibility.json" },
    "tables": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z_]+$" },
          "kind": { "enum": ["capability-business", "technical", "legacy-business"] },
          "owner": { "type": "string", "pattern": "^backend:[a-z][a-z0-9_]*$" },
          "compatibilityResources": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^table:[a-z][a-z0-9_]*$" }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "capability-business" } } },
            "then": { "required": ["owner"] },
            "else": { "not": { "required": ["owner"] } }
          },
          {
            "if": { "required": ["compatibilityResources"] },
            "then": { "properties": { "kind": { "const": "capability-business" } } }
          }
        ],
        "additionalProperties": false
      }
    },
    "preservedSourceRetirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "successor",
          "issue",
          "artifacts"
        ],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^public\\.[a-z_]+$"
          },
          "successor": {
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z_]+$"
          },
          "issue": {
            "type": "string",
            "pattern": "^#[0-9]+$"
          },
          "artifacts": {
            "type": "object",
            "required": [
              "cutover",
              "contract",
              "rollback"
            ],
            "properties": {
              "cutover": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^supabase/(contract-migrations|rollback)/[a-z0-9_]+\\.sql$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
              },
              "contract": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^supabase/(contract-migrations|rollback)/[a-z0-9_]+\\.sql$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
              },
              "rollback": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^supabase/(contract-migrations|rollback)/[a-z0-9_]+\\.sql$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
