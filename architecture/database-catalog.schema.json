{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talli.no/schemas/architecture/database-catalog.schema.json",
  "type": "object",
  "required": ["schemaVersion", "source", "ownershipPolicy", "compatibilityAdapterRegistry", "tables"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "source": { "const": "supabase/migrations" },
    "ownershipPolicy": { "const": "capability owners are authoritative" },
    "compatibilityAdapterRegistry": { "const": "architecture/compatibility.json" },
    "tables": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z_]+$" },
          "kind": { "enum": ["capability-business", "technical", "legacy-business"] },
          "owner": { "type": "string", "pattern": "^backend:[a-z][a-z0-9_]*$" },
          "compatibilityResources": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^table:[a-z][a-z0-9_]*$" }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "capability-business" } } },
            "then": { "required": ["owner"] },
            "else": { "not": { "required": ["owner"] } }
          },
          {
            "if": { "required": ["compatibilityResources"] },
            "then": { "properties": { "kind": { "const": "capability-business" } } }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
