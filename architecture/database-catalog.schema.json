{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talli.no/schemas/architecture/database-catalog.schema.json",
  "type": "object",
  "required": ["schemaVersion", "source", "tables"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "source": { "const": "supabase/migrations" },
    "tables": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "pattern": "^public\\.[a-z_]+$" },
          "kind": { "enum": ["capability-business", "technical", "legacy-business"] },
          "owner": { "type": "string", "pattern": "^backend:[a-z][a-z0-9_]*$" }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "capability-business" } } },
            "then": { "required": ["owner"] },
            "else": { "not": { "required": ["owner"] } }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
