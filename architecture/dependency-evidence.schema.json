{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talli.no/schemas/architecture/dependency-evidence.schema.json",
  "type": "object",
  "required": ["schemaVersion", "generatedBy", "modules", "edges", "technicalOwnership"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "generatedBy": { "const": "scripts/check-architecture.mjs" },
    "modules": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "edges": { "type": "array", "items": { "type": "object", "required": ["from", "to", "kind", "imports"], "properties": { "from": { "type": "string" }, "to": { "type": "string" }, "kind": { "type": "string" }, "imports": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false } },
    "technicalOwnership": { "type": "array", "items": { "type": "object", "required": ["owner", "table"], "properties": { "owner": { "const": "backend-system" }, "table": { "type": "string", "pattern": "^public\\." } }, "additionalProperties": false } }
  },
  "additionalProperties": false
}
