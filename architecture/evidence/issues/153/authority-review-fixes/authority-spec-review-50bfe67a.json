  ],
  "findings": [
    {
      "id": "SPEC-153-AUTH-1",
      "severity": "P2",
      "file": "apps/backend/src/talli_backend/authority_tools/annual_accounts_payload.py",
      "startLine": 8,
      "endLine": 9,
      "title": "Preserve false-like Annual input defaults at the CLI mapping",
      "spec": "GH-153-A1: Supported annual-accounts cases produce outputs identical to current schema and TT02 evidence.",
      "description": "Using the unchanged valid 2025 payload fixture, annualData false, 0, -0.0 or empty string returns original XML and empty feedback through the original 57df4221 _filing.payload/Node subprocess. The new mapping passes these scalar values into AnnualAccountsSource; calculation calls .get() and the wrapper raises ValueError: Local authority payload generation failed. Raw rehearsal case annualData reaches this path unchanged. Preserve the released false-like behavior at the boundary without replacing truthy malformed shapes with absent data."
    },
    {
      "id": "SPEC-153-AUTH-2",
      "severity": "P2",
      "file": "apps/backend/src/talli_backend/authority_tools/annual_accounts_payload.py",
      "startLine": 10,
      "endLine": 10,
      "title": "Reject non-array Ledger payloads before calculating",
      "spec": "GH-153-A1 plus #132 characterization of exact supported outputs and errors.",
      "description": "For direct fixed payload generation, ledgerEntries {} or empty string previously fails because the released bridge expects an array. The new mapping admits both values; Python iterates them as empty and emits zero-balance XML without feedback. Require the accepted collection shape while preserving missing/null defaults. The outer rehearsal already normalizes these false-like Ledger values; this finding concerns the migrated fixed payload/public mapping boundary, not a claim that the live rehearsal newly accepts such cases."
    }
  ],
