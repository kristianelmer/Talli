    "statement": "These tables implement idempotency, cursor signing, migration evidence, operational control, bounded consented measurement, bounded invited-validation evidence, and event delivery only; they own no accounting, filing, billing policy, eligibility, acquisition-spend, product-behavior, or authorization decision."
  },
  "infrastructure": {
    "transactions": "Short Postgres transactions owned by backend application workflows.",
    "idempotency": "Durable idempotency records are required for consequential commands before provider I/O.",
    "eventDelivery": "public.notification_outbox is the persisted event-delivery boundary.",
    "migrationRunner": "Supabase migrations in supabase/migrations are applied by the deployment migration runner.",
    "durableWorker": "A durable worker consumes persisted delivery state outside the initiating transaction."
  },
  "adapterBindings": [
    {
      "port": "SystemBoundaryTransport",
      "adapter": "talli_backend.main.create_app",
      "owner": "backend-system",
      "mode": "in-process FastAPI composition"
    },
    {
      "port": "MarketingMeasurementGateway",
      "adapter": "talli_backend.adapters.supabase_marketing_measurement.SupabaseMarketingMeasurementAdapter",
      "owner": "backend-system",
      "mode": "private generated-client transport and SET-only restricted PostgreSQL functions"
    },
    {
      "port": "ValidationObservationGateway",
      "adapter": "talli_backend.adapters.supabase_validation_observation.SupabaseValidationObservationAdapter",
      "owner": "backend-system",
      "mode": "passive post-outcome writer through one SET-only restricted PostgreSQL function"
    },
    {
      "port": "CompanyAccessGateway",
      "adapter": "talli_backend.adapters.supabase_company_access.SupabaseCompanyAccessAdapter",
      "owner": "backend-system",
      "mode": "injected Supabase Auth and restricted Postgres adapter"
    },
    {
      "port": "CompanyRegistryGateway",
      "adapter": "talli_backend.adapters.brreg_company_registry.BrregCompanyRegistryAdapter",
      "owner": "backend-system",
      "mode": "injected bounded HTTPS public-registry adapter"
    },
    {
      "port": "LedgerPersistence",
      "adapter": "talli_backend.adapters.supabase_ledger.SupabaseLedgerSession",
      "owner": "backend-system",
      "mode": "request-scoped verified-actor restricted PostgreSQL adapter"
    },
    {
      "port": "InvestmentsPersistence",
      "adapter": "talli_backend.adapters.supabase_investments.SupabaseInvestmentsSession",
      "owner": "backend-system",
      "mode": "request-scoped verified-actor restricted PostgreSQL adapter"
    },
    {
      "port": "DocumentsPersistence",
      "adapter": "talli_backend.adapters.supabase_documents.SupabaseDocumentsPersistence",
      "owner": "backend-system",
      "mode": "request-scoped verified-actor restricted PostgreSQL adapter"
    },
    {
      "port": "DocumentObjectStorage",
      "adapter": "talli_backend.adapters.supabase_documents.SupabaseDocumentObjectStorage",
      "owner": "backend-system",
      "mode": "backend-only exact-object Supabase Storage adapter"
    },
    {
      "port": "DocumentsAuthorization",
      "adapter": "talli_backend.adapters.supabase_documents.SupabaseDocumentsAuthorization",
      "owner": "backend-system",
      "mode": "request-scoped accepted-membership facts through the company-access public gateway"
    },
    {
      "port": "BankTransactionClaimPersistence",
      "adapter": "talli_backend.adapters.supabase_investments.SupabaseInvestmentsTransaction",
      "owner": "backend-system",
      "mode": "same-request investments transaction using the restricted locked banking claim"
    },
    {
      "port": "CorporateGovernancePersistence",
      "adapter": "talli_backend.adapters.supabase_corporate_governance.SupabaseCorporateGovernanceSession",
      "owner": "backend-system",
      "mode": "request-scoped verified-owner restricted PostgreSQL adapter"
    },
    {
      "port": "BillingPersistence",
      "adapter": "talli_backend.adapters.supabase_billing.SupabaseBillingSession",
      "owner": "backend-system",
      "mode": "request-scoped verified-actor restricted PostgreSQL adapter"
    },
    {
      "port": "BillingPaymentProvider",
      "adapter": "talli_backend.adapters.simulation_billing.SimulationBillingProvider",
      "owner": "backend-system",
      "mode": "production-disabled deterministic simulation adapter"
    },
    {
      "port": "BankTransactionClaimPersistence",
      "adapter": "talli_backend.adapters.supabase_corporate_governance.SupabaseCorporateGovernanceTransaction",
      "owner": "backend-system",
      "mode": "same-request governance transaction using the governance-specific restricted banking claim"
    },
    {
      "port": "BankingPersistence",
      "adapter": "talli_backend.adapters.supabase_banking.SupabaseBankingSession",
      "owner": "backend-system",
      "mode": "request-scoped verified-actor restricted PostgreSQL adapter"
    },
    {
      "port": "BankDataProvider",
      "adapter": "talli_backend.adapters.neonomics_banking.NeonomicsBankingAdapter",
      "owner": "backend-system",
      "mode": "disabled-until-approved read-only Neonomics edge adapter with injected transport"
    },
    {
      "port": "BankDataProvider",
      "adapter": "talli_backend.adapters.enable_banking.EnableBankingAdapter",
      "owner": "backend-system",
      "mode": "disabled-until-approved read-only Enable Banking fallback adapter with injected transport"
    },
    {
      "port": "AnnualBillingProvider",
      "adapter": "talli_backend.adapters.vipps_billing.VippsTestBillingProvider",
      "owner": "backend-system",
      "mode": "test-origin-only adapter; runtime composition pending #192, no production activation"
    },
    {
      "port": "AnnualCheckoutPersistence",
      "adapter": "talli_backend.adapters.postgres_annual_checkout.PostgresAnnualCheckoutSession",
      "owner": "backend-system",
      "mode": "restricted verified-actor PostgreSQL claims and settlement; readiness defaults unavailable; runtime cutover pending #192"
    },
    {
      "port": "AnnualCancellationPersistence",
      "adapter": "talli_backend.adapters.postgres_annual_checkout.PostgresAnnualCancellationSession",
      "owner": "backend-system",
      "mode": "verified-owner local renewal cancellation and immutable receipts; provider cleanup and runtime cutover pending #192"
    },
    {
      "port": "AnnualAgreementCleanupPersistence",
      "adapter": "talli_backend.adapters.postgres_annual_cleanup.PostgresAnnualCleanupSession",
      "owner": "backend-system",
      "mode": "verified-owner receipt-bound original agreement cleanup; runtime and worker authority pending #192"
    }
  ],
