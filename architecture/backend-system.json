{
  "schemaVersion": "1.0",
  "name": "talli-backend-system",
  "documentation": "architecture/BACKEND-SYSTEM.md",
  "compositionRoot": "apps/backend/src/talli_backend/main.py",
  "workflows": [
    {
      "name": "system-boundary-tracer",
      "purpose": "Returns a deterministic availability response from the independently deployable FastAPI boundary.",
      "publicPackages": ["talli_backend.modules.system_boundary.public"],
      "routes": ["/api/v1/system-boundary/tracer"]
    },
    {
      "name": "company-access-context",
      "purpose": "Returns the authenticated, policy-authorized selected company context through FastAPI.",
      "publicPackages": ["talli_backend.modules.company_access.public"],
      "routes": ["/api/v1/company-access/context"]
    },
    {
      "name": "company-year-eligibility-and-admission",
      "purpose": "Runs the public provisional company check, definitive manifest-owned interview, authenticated atomic company-year admission, and append-only post-admission safety rechecks through the company_access public package.",
      "publicPackages": ["talli_backend.modules.company_access.public"],
      "routes": [
        "/api/v1/company-access/eligibility/precheck",
        "/api/v1/company-access/eligibility/definitive",
        "/api/v1/company-access/company-year-admissions",
        "/api/v1/company-access/company-year-admissions/{company_year_admission_id}/eligibility-rechecks"
      ]
    },
    {
      "name": "company-access-onboarding-and-support",
      "purpose": "Retains the fail-closed legacy onboarding response, runs agreement reacceptance, accepted-member company lookup, and bounded support-operator context and company search through the company_access public package.",
      "publicPackages": ["talli_backend.modules.company_access.public"],
      "routes": [
        "/api/v1/company-access/onboarding",
        "/api/v1/company-access/agreements/reaccept",
        "/api/v1/company-access/companies/{company_id}",
        "/api/v1/company-access/operator-context",
        "/api/v1/company-access/operator-companies"
      ]
    },
    {
      "name": "company-access-administration",
      "purpose": "Runs invitation, reviewer/read-only membership, cancellation, and deletion-review workflows atomically through the company_access public package.",
      "publicPackages": ["talli_backend.modules.company_access.public"],
      "routes": [
        "/api/v1/company-access/invitations",
        "/api/v1/company-access/invitations/lookup",
        "/api/v1/company-access/invitations/accept",
        "/api/v1/company-access/invitations/{invitation_id}/revoke",
        "/api/v1/company-access/invitations/{invitation_id}/resend",
        "/api/v1/company-access/invitation-side-effects/pending",
        "/api/v1/company-access/invitation-side-effects/{operation_id}/complete",
        "/api/v1/company-access/memberships",
        "/api/v1/company-access/memberships/{user_id}",
        "/api/v1/company-access/cancellations",
        "/api/v1/company-access/cancellations/{cancellation_id}/resume",
        "/api/v1/company-access/cancellations/{cancellation_id}/reviews",
        "/api/v1/company-access/cancellations/{cancellation_id}/finalize"
      ]
    },
    {
      "name": "ledger-posting-and-period-control",
      "purpose": "Authenticates one verified actor and runs intent-specific narrow-ledger posting, deterministic cursor queries, and company-year locking through the ledger public package.",
      "publicPackages": ["talli_backend.modules.ledger.public"],
      "routes": [
        "/api/v1/ledger/entries",
        "/api/v1/ledger/period-locks",
        "/api/v1/ledger/opening-balances",
        "/api/v1/ledger/administrative-costs",
        "/api/v1/ledger/manual-journals"
      ]
    }
  ],
  "operationalControlState": {
    "owner": "backend-system",
    "tables": ["public.launch_signoffs"],
    "releaseDecision": "deny-by-default",
    "consequentialAdapterRecheck": true
  },
  "technicalOwnership": {
    "schemas": ["backend_system", "public"],
    "tables": ["backend_system.ledger_command_receipts", "backend_system.ledger_cursor_signing_keys", "backend_system.ledger_migration_quarantine", "backend_system.ledger_migration_reconciliations", "backend_system.ledger_migration_runs", "backend_system.ledger_migration_source_rows", "public.company_access_command_receipts", "public.launch_signoffs", "public.notification_outbox"],
    "migrations": ["supabase/migrations/0001_authenticated_workspace.sql", "supabase/migrations/20260801090000_company_access_invitations.sql", "supabase/migrations/20260808120000_company_access_cancellation_lifecycle.sql", "supabase/migrations/20260826100000_company_access_onboarding.sql", "supabase/migrations/20260826110000_company_year_admission.sql", "supabase/migrations/20260827100000_ledger_capability.sql"],
    "statement": "These tables implement idempotency, cursor signing, migration evidence, operational control, and event delivery only; they own no accounting, filing, billing, or authorization decision."
  },
  "infrastructure": {
    "transactions": "Short Postgres transactions owned by backend application workflows.",
    "idempotency": "Durable idempotency records are required for consequential commands before provider I/O.",
    "eventDelivery": "public.notification_outbox is the persisted event-delivery boundary.",
    "migrationRunner": "Supabase migrations in supabase/migrations are applied by the deployment migration runner.",
    "durableWorker": "A durable worker consumes persisted delivery state outside the initiating transaction."
  },
  "adapterBindings": [
    {
      "port": "SystemBoundaryTransport",
      "adapter": "talli_backend.main.create_app",
      "owner": "backend-system",
      "mode": "in-process FastAPI composition"
    },
    {
      "port": "CompanyAccessGateway",
      "adapter": "talli_backend.adapters.supabase_company_access.SupabaseCompanyAccessAdapter",
      "owner": "backend-system",
      "mode": "injected Supabase Auth and restricted Postgres adapter"
    },
    {
      "port": "CompanyRegistryGateway",
      "adapter": "talli_backend.adapters.brreg_company_registry.BrregCompanyRegistryAdapter",
      "owner": "backend-system",
      "mode": "injected bounded HTTPS public-registry adapter"
    },
    {
      "port": "LedgerPersistence",
      "adapter": "talli_backend.adapters.supabase_ledger.SupabaseLedgerSession",
      "owner": "backend-system",
      "mode": "request-scoped verified-actor restricted PostgreSQL adapter"
    }
  ],
  "allowedDependencies": {
    "transport": ["__future__", "re", "collections", "datetime", "typing", "uuid", "fastapi", "fastapi.security", "pydantic", "starlette", "talli_backend.adapters.brreg_company_registry", "talli_backend.adapters.supabase_company_access", "talli_backend.adapters.supabase_ledger", "talli_backend.application.ledger_workflow", "talli_backend.modules.company_access.public", "talli_backend.modules.ledger.public", "talli_backend.modules.system_boundary.public", "talli_backend.openapi", "talli_backend.shared.kernel"],
    "workflows": ["talli_backend.modules.company_access.public", "talli_backend.modules.ledger.public", "talli_backend.modules.system_boundary.public"],
    "adapters": ["__future__", "asyncio", "base64", "collections.abc", "dataclasses", "datetime", "decimal", "ipaddress", "json", "os", "psycopg", "psycopg.rows", "re", "talli_backend.application.ledger_session", "talli_backend.application.ledger_workflow", "talli_backend.modules.company_access.public", "talli_backend.modules.ledger.public", "talli_backend.modules.ledger.service", "talli_backend.shared.kernel", "urllib.error", "urllib.parse", "urllib.request"]
  }
}
