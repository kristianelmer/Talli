{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talli.no/schemas/architecture/backend-system.schema.json",
  "title": "Talli backend system manifest",
  "type": "object",
  "required": ["schemaVersion", "name", "documentation", "compositionRoot", "workflows", "operationalControlState", "technicalOwnership", "infrastructure", "adapterBindings", "allowedDependencies"],
  "properties": {
    "schemaVersion": { "const": "1.0" }, "name": { "const": "talli-backend-system" }, "documentation": { "const": "architecture/BACKEND-SYSTEM.md" }, "compositionRoot": { "type": "string", "pattern": "^apps/backend/src/" },
    "workflows": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "purpose", "publicPackages", "routes"], "properties": { "name": { "type": "string", "minLength": 1 }, "purpose": { "type": "string", "minLength": 1 }, "publicPackages": { "$ref": "#/$defs/nonEmptyStringArray" }, "routes": { "$ref": "#/$defs/nonEmptyStringArray" } }, "additionalProperties": false } },
    "operationalControlState": { "type": "object", "required": ["owner", "tables", "releaseDecision", "consequentialAdapterRecheck"], "properties": { "owner": { "const": "backend-system" }, "tables": { "$ref": "#/$defs/nonEmptyStringArray" }, "releaseDecision": { "const": "deny-by-default" }, "consequentialAdapterRecheck": { "const": true } }, "additionalProperties": false },
    "technicalOwnership": { "type": "object", "required": ["schemas", "tables", "migrations", "statement"], "properties": { "schemas": { "$ref": "#/$defs/nonEmptyStringArray" }, "tables": { "$ref": "#/$defs/nonEmptyStringArray" }, "migrations": { "$ref": "#/$defs/nonEmptyStringArray" }, "statement": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
    "infrastructure": { "type": "object", "required": ["transactions", "idempotency", "eventDelivery", "migrationRunner", "durableWorker"], "additionalProperties": { "type": "string", "minLength": 1 } },
    "adapterBindings": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["port", "adapter", "owner", "mode"], "properties": { "port": { "type": "string", "minLength": 1 }, "adapter": { "type": "string", "minLength": 1 }, "owner": { "const": "backend-system" }, "mode": { "type": "string", "minLength": 1 } }, "additionalProperties": false } },
    "allowedDependencies": { "type": "object", "required": ["transport", "workflows", "adapters"], "properties": { "transport": { "$ref": "#/$defs/stringArray" }, "workflows": { "$ref": "#/$defs/stringArray" }, "adapters": { "$ref": "#/$defs/stringArray" } }, "additionalProperties": false }
  },
  "$defs": { "stringArray": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }, "nonEmptyStringArray": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true } },
  "additionalProperties": false
}
