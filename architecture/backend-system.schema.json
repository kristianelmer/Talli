{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talli.no/schemas/architecture/backend-system.schema.json",
  "title": "Talli backend system manifest",
  "type": "object",
  "required": ["schemaVersion", "name", "documentation", "compositionRoot", "workflows", "operationalControlState", "technicalOwnership", "infrastructure", "adapterBindings", "allowedDependencies"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "name": { "const": "talli-backend-system" },
    "documentation": { "const": "architecture/BACKEND-SYSTEM.md" },
    "compositionRoot": { "type": "string", "pattern": "^apps/backend/src/" },
    "workflows": { "type": "array", "minItems": 1 },
    "operationalControlState": { "type": "object" },
    "technicalOwnership": { "type": "object" },
    "infrastructure": { "type": "object" },
    "adapterBindings": { "type": "array", "minItems": 1 },
    "allowedDependencies": { "type": "object" }
  },
  "additionalProperties": false
}
