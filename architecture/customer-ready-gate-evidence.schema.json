{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talli.no/schemas/architecture/customer-ready-gate-evidence.schema.json",
  "type": "object",
  "required": ["schemaVersion", "revision", "previousPassingRevision", "workflow", "executor", "producer", "producerDigest", "transcriptPath", "transcriptDigest", "startedAt", "executedAt", "verdict", "checks"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "previousPassingRevision": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      ]
    },
    "workflow": { "const": "customer-ready-release-gate" },
    "executor": { "const": "local-script" },
    "producer": { "const": "scripts/run-customer-ready-gate.mjs" },
    "producerDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "transcriptPath": { "type": "string", "pattern": "^architecture/evidence/customer-ready-gates/[a-f0-9]{40}\\.log$" },
    "transcriptDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "executedAt": { "type": "string", "format": "date-time" },
    "verdict": { "const": "pass" },
    "checks": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "required": ["name", "command", "exitCode", "durationMs"],
        "properties": {
          "name": {
            "enum": [
              "credential-scan",
              "typecheck",
              "architecture",
              "boundary",
              "build-web",
              "build-backend",
              "boundary-smoke",
              "launch-rehearsal",
              "production-dependency-audit",
              "database-isolation",
              "whitespace"
            ]
          },
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "const": 0 },
          "durationMs": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
