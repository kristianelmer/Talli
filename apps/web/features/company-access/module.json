{
  "schemaVersion": "1.0",
  "kind": "web-feature",
  "name": "company-access",
  "path": "apps/web/features/company-access",
  "owner": "web:company-access",
  "purpose": "Load authenticated company and operator context, perform bounded operator company search, and carry company onboarding, agreement reacceptance, invitation and membership administration, cancellation request/resume, deletion review, and deletion finalization through the committed generated API client.",
  "documentation": "apps/web/features/company-access/MODULE.md",
  "publicEntryPoint": "@/features/company-access",
  "publicImportPaths": ["@/features/company-access", "apps/web/features/company-access", "apps/web/features/company-access/index.ts"],
  "ownedRoutes": ["/dashboard", "/connections", "/workspace", "/operator", "/onboarding", "/invite/accept", "/companies/[companyId]/annual-reporting/[incomeYear]"],
  "apiOperations": ["companyAccessGetSelectedContext", "companyAccessGetCompanyRecord", "companyAccessGetOperatorContext", "companyAccessSearchOperatorCompanies", "companyAccessOnboardCompany", "companyAccessReacceptAgreement", "companyAccessListInvitations", "companyAccessCreateInvitation", "companyAccessLookupInvitation", "companyAccessAcceptInvitation", "companyAccessRevokeInvitation", "companyAccessResendInvitation", "companyAccessListPendingInvitationSideEffects", "companyAccessCompleteInvitationSideEffect", "companyAccessListMemberships", "companyAccessAdministerMembership", "companyAccessListCancellations", "companyAccessRequestCancellation", "companyAccessResumeCancellation", "companyAccessReviewDeletion", "companyAccessFinalizeDeletion"],
  "dependencies": [],
  "allowedImports": ["#backend-configuration", "@talli/talli-api-client"],
  "cachePolicy": { "default": "no-store", "allowed": [] },
  "directBrowserFlows": [],
  "forbiddenResponsibilities": [
    "Company membership, invitation, role, resource-scope, AAL2, or tenant-concealment policy",
    "Direct Supabase business persistence or business-endpoint fetch calls",
    "Handwritten business DTOs or generated-client deep imports"
  ],
  "tests": {
    "feature": "apps/web/tests/company-access-administration.test.mjs",
    "stageExit": "apps/web/tests/company-access-stage-exit.test.mjs",
    "architecture": "tests/architecture_foundation.test.mjs"
  },
  "compatibilityExceptions": []
}
