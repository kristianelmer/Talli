{
  "schemaVersion": "1.0",
  "kind": "web-feature",
  "name": "system-boundary",
  "path": "apps/web/features/system-boundary",
  "owner": "web:system-boundary",
  "purpose": "Present the FastAPI tracer and own minimal web operational health with bounded backend/Auth readiness probes.",
  "documentation": "apps/web/features/system-boundary/MODULE.md",
  "publicEntryPoint": "@/features/system-boundary",
  "publicImportPaths": [
    "@/features/system-boundary",
    "apps/web/features/system-boundary",
    "apps/web/features/system-boundary/index.ts"
  ],
  "ownedRoutes": [
    "/system-boundary",
    "/health/live",
    "/health/ready"
  ],
  "apiOperations": [
    "systemBoundaryGetTracerStatus"
  ],
  "dependencies": [],
  "allowedImports": [
    "#backend-configuration",
    "@talli/talli-api-client"
  ],
  "cachePolicy": {
    "default": "no-store",
    "allowed": [
      "Process-local operational readiness boolean for two seconds; no user data or upstream diagnostics."
    ]
  },
  "directBrowserFlows": [],
  "forbiddenResponsibilities": [
    "Business policy or handwritten business DTOs",
    "Direct Supabase business persistence",
    "Direct business-endpoint fetch calls",
    "Generated-client deep imports"
  ],
  "tests": {
    "feature": "apps/web/tests/system-boundary-presentation.test.mjs",
    "architecture": "tests/architecture_foundation.test.mjs"
  },
  "compatibilityExceptions": []
}
