    "identifiers": ["DocumentId", "DocumentObjectStorage", "DocumentsAuthorization", "DocumentsPersistence", "DocumentStatus", "DocumentTransferKind", "DocumentsSession", "DocumentsSessionFactory", "StoredDocumentObject", "document_object_storage_adapter", "documents_authorization_adapter", "documents_persistence_adapter"]
  },
  "owns": {
    "postgresSchemas": ["documents"],
    "tables": ["public.documents"],
    "storageBuckets": ["company-documents"],
    "projections": ["DocumentBackupObject"],
