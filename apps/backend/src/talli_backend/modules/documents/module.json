    {"name": "DocumentObjectStorage", "direction": "outbound", "contract": "talli_backend.modules.documents.public.DocumentObjectStorage", "registrationDecorator": "talli_backend.modules.documents.public.document_object_storage_adapter", "adapters": ["talli_backend.adapters.supabase_documents.SupabaseDocumentObjectStorage"]},
    {"name": "DocumentsAuthorization", "direction": "outbound", "contract": "talli_backend.modules.documents.public.DocumentsAuthorization", "registrationDecorator": "talli_backend.modules.documents.public.documents_authorization_adapter", "adapters": ["talli_backend.adapters.supabase_documents.SupabaseDocumentsAuthorization"]}
  ],
  "dependencies": [],
