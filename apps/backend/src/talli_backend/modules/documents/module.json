{
  "schemaVersion": "1.0",
  "kind": "backend-capability",
  "name": "documents",
  "path": "apps/backend/src/talli_backend/modules/documents",
  "owner": "backend:documents",
  "purpose": "Own accounting-document validation, metadata, private single-object transfers, integrity, retention, safe removal, and backup projections.",
  "documentation": "apps/backend/src/talli_backend/modules/documents/MODULE.md",
  "publicEntryPoint": "talli_backend.modules.documents.public",
  "exports": {
    "commands": [
      "BeginDocumentUploadCommand",
      "DocumentEvidenceRetentionCommand"
    ],
    "queries": [
      "DocumentBackupObject",
      "DocumentBindingQuery",
      "DocumentObjectTransfer",
      "DocumentRecord",
      "DocumentRestoreObject",
      "DocumentRestorePlan",
      "DocumentUploadTransfer",
      "VerifiedDocumentEvidence",
      "document_metadata_sha256"
    ],
    "events": [],
    "errors": [
      "DocumentsError",
      "DocumentErrorCode"
    ],
    "identifiers": [
      "DocumentBindingPersistence",
      "DocumentId",
      "DocumentObjectStorage",
      "DocumentStatus",
      "DocumentTransferKind",
      "DocumentsAuthorization",
      "DocumentsPersistence",
      "DocumentsSession",
      "DocumentsSessionFactory",
      "StoredDocumentObject",
      "document_binding_persistence_adapter",
      "document_object_storage_adapter",
      "documents_authorization_adapter",
      "documents_persistence_adapter",
      "DocumentEvidenceRetentionPersistence",
      "document_evidence_retention_adapter"
    ]
  },
  "owns": {
    "postgresSchemas": [
      "documents"
    ],
    "tables": [
      "documents.evidence_references",
      "public.documents"
    ],
    "storageBuckets": [
      "company-documents"
    ],
    "projections": [
      "DocumentBackupObject"
    ],
    "migrations": "supabase/migrations/20260902030000_documents_evidence_reference_registry.sql; supabase/migrations/20260923102419_documents_verified_rf_evidence_retention.sql; supabase/migrations/20260923125730_documents_ledger_evidence_guard.sql"
  },
  "ports": [
    {
      "name": "DocumentsPersistence",
      "direction": "outbound",
      "contract": "talli_backend.modules.documents.public.DocumentsPersistence",
      "registrationDecorator": "talli_backend.modules.documents.public.documents_persistence_adapter",
      "adapters": [
        "talli_backend.adapters.supabase_documents.SupabaseDocumentsPersistence"
      ]
    },
    {
      "name": "DocumentObjectStorage",
      "direction": "outbound",
      "contract": "talli_backend.modules.documents.public.DocumentObjectStorage",
      "registrationDecorator": "talli_backend.modules.documents.public.document_object_storage_adapter",
      "adapters": [
        "talli_backend.adapters.supabase_documents.SupabaseDocumentObjectStorage"
      ]
    },
    {
      "name": "DocumentsAuthorization",
      "direction": "outbound",
      "contract": "talli_backend.modules.documents.public.DocumentsAuthorization",
      "registrationDecorator": "talli_backend.modules.documents.public.documents_authorization_adapter",
      "adapters": [
        "talli_backend.adapters.supabase_documents.SupabaseDocumentsAuthorization"
      ]
    },
    {
      "name": "DocumentBindingPersistence",
      "direction": "outbound",
      "contract": "talli_backend.modules.documents.public.DocumentBindingPersistence",
      "registrationDecorator": "talli_backend.modules.documents.public.document_binding_persistence_adapter",
      "adapters": [
        "talli_backend.adapters.postgres_company_tax_filing.PostgresCompanyTaxTransaction"
      ]
    },
    {
      "name": "DocumentEvidenceRetentionPersistence",
      "direction": "outbound",
      "contract": "talli_backend.modules.documents.public.DocumentEvidenceRetentionPersistence",
      "registrationDecorator": "talli_backend.modules.documents.public.document_evidence_retention_adapter",
      "adapters": [
        "talli_backend.adapters.postgres_document_evidence.PostgresDocumentEvidenceRetention"
      ]
    }
  ],
  "dependencies": [],
  "allowedImports": [
    "__future__",
    "collections.abc",
    "dataclasses",
    "datetime",
    "enum",
    "hashlib",
    "json",
    "re",
    "talli_backend.shared.kernel",
    "typing",
    "unicodedata",
    "uuid"
  ],
  "forbiddenResponsibilities": [
    "Corporate-governance, filing, ledger, investment, authority, or archive composition policy",
    "Provider-specific object policy in the public contract",
    "Direct browser metadata mutation, bucket listing, arbitrary object keys, or object deletion"
  ],
  "tests": {
    "policy": "apps/backend/tests/test_documents.py",
    "adapter": "apps/backend/tests/test_supabase_documents.py",
    "database": "tests/documents_database_runtime.test.mjs",
    "architecture": "tests/architecture_foundation.test.mjs",
    "evidenceRetention": "apps/backend/tests/test_document_evidence_retention.py",
    "evidenceRetentionDatabase": "apps/backend/tests/test_document_evidence_retention_database.py"
  },
  "compatibilityExceptions": []
}
