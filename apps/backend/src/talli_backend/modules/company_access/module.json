{
  "schemaVersion": "1.0",
  "kind": "backend-capability",
  "name": "company_access",
  "path": "apps/backend/src/talli_backend/modules/company_access",
  "owner": "backend:company_access",
  "purpose": "Own authenticated company context, invitation and cancellation lifecycles, non-owner membership administration, and support deletion review with validated sessions, fresh AAL2 policy, RLS, atomic transitions, and tenant concealment.",
  "documentation": "apps/backend/src/talli_backend/modules/company_access/MODULE.md",
  "publicEntryPoint": "talli_backend.modules.company_access.public",
  "exports": {
    "commands": ["AcceptCompanyInvitationRequest", "AdministerCompanyMembershipRequest", "CompanyInvitationCommandRequest", "CreateCompanyInvitationRequest", "FinalizeCompanyDeletionRequest", "RequestCompanyCancellationRequest", "ReviewCompanyDeletionRequest"],
    "queries": ["CompanyAccessService", "CompanyCancellationListResponse", "CompanyContextResponse", "CompanyInvitationListResponse", "CompanyMembershipListResponse", "InvitationLookup", "InvitationSideEffectContinuationList", "InvitationSideEffectCompletion"],
    "events": [],
    "errors": ["CompanyAccessError"],
    "identifiers": ["CompanyAccessGateway", "CompanyCancellation", "CompanyContext", "CompanyDeletionReview", "CompanyInvitation", "CompanyMembership", "InvitationRole", "InvitationSideEffectContinuation", "MembershipState", "company_access_adapter"]
  },
  "owns": {
    "postgresSchemas": ["public"],
    "tables": ["public.companies", "public.company_cancellations", "public.company_deletion_reviews", "public.company_invitations", "public.company_memberships"],
    "storageBuckets": [],
    "projections": [],
    "migrations": "supabase/migrations/20260808120000_company_access_cancellation_lifecycle.sql"
  },
  "ports": [
    {
      "name": "CompanyAccessGateway",
      "direction": "outbound",
      "contract": "talli_backend.modules.company_access.public.CompanyAccessGateway",
      "registrationDecorator": "talli_backend.modules.company_access.public.company_access_adapter",
      "adapters": ["talli_backend.adapters.supabase_company_access.SupabaseCompanyAccessAdapter"]
    }
  ],
  "dependencies": [],
  "allowedImports": ["__future__", "base64", "collections.abc", "datetime", "hashlib", "json", "pydantic", "re", "secrets", "typing", "uuid"],
  "forbiddenResponsibilities": [
    "Company onboarding, agreement acceptance, physical business-data deletion, or general support-operator workflows",
    "Service-role access or RLS bypass for ordinary business reads",
    "Web presentation, handwritten web DTOs, or direct browser persistence"
  ],
  "tests": {
    "contract": "apps/backend/tests/test_company_access.py",
    "architecture": "tests/architecture_foundation.test.mjs"
  },
  "compatibilityExceptions": ["compat-audit-persistence", "compat-company-archive-persistence"]
}
