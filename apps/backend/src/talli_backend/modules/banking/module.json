{
  "schemaVersion": "1.0",
  "kind": "backend-capability",
  "name": "banking",
  "path": "apps/backend/src/talli_backend/modules/banking",
  "owner": "backend:banking",
  "purpose": "Own bank statement capture, canonical duplicate identity, deterministic account-free suggestions, explicit acceptance, reconciliation state, and bank-provider source ports.",
  "documentation": "apps/backend/src/talli_backend/modules/banking/MODULE.md",
  "publicEntryPoint": "talli_backend.modules.banking.public",
  "exports": {
    "commands": ["AcceptBankSuggestionCommand", "BankingCommand", "BankingCommands", "BeginBankConsentRequest", "CompleteBankConsentRequest", "FetchBankTransactionsRequest", "ImportBankStatementCommand", "RevokeBankConsentRequest"],
    "queries": ["AcceptedBankSuggestion", "BankConsentRedirect", "BankProviderAccount", "BankProviderConnection", "BankProviderTransaction", "BankProviderTransactionPage", "BankStatementImportResult", "BankSuggestionAcceptancePage", "BankTransaction", "BankTransactionPage", "BankingQueries", "PreparedBankSuggestion"],
    "events": [],
    "errors": ["BankingError", "BankingErrorCode"],
    "identifiers": ["AccountingEntryReference", "BankConnectionId", "BankConnectorId", "BankDataProvider", "BankSuggestion", "BankSuggestionAcceptanceId", "BankSuggestionKind", "BankSyncMode", "BankTransactionId", "BankTransactionState", "BankingCursor", "BankingPage", "BankingPersistence", "CURRENT_BANK_SUGGESTION_RULE_VERSION", "ExternalActionReference", "ImportedBankTransaction", "SupportedBankDataFormat", "bank_data_provider_adapter", "banking_persistence_adapter"]
  },
  "owns": {
    "postgresSchemas": ["banking"],
    "tables": ["banking.suggestion_acceptances", "banking.transactions"],
    "storageBuckets": [],
    "projections": ["public.bank_transactions"],
    "migrations": "supabase/migrations/20260828100000_banking_capability.sql"
  },
  "ports": [
    {
      "name": "BankingPersistence",
      "direction": "outbound",
      "contract": "talli_backend.modules.banking.public.BankingPersistence",
      "registrationDecorator": "talli_backend.modules.banking.public.banking_persistence_adapter",
      "adapters": ["talli_backend.adapters.supabase_banking.SupabaseBankingSession"]
    },
    {
      "name": "BankDataProvider",
      "direction": "outbound",
      "contract": "talli_backend.modules.banking.public.BankDataProvider",
      "registrationDecorator": "talli_backend.modules.banking.public.bank_data_provider_adapter",
      "adapters": ["talli_backend.adapters.enable_banking.EnableBankingAdapter", "talli_backend.adapters.neonomics_banking.NeonomicsBankingAdapter"]
    }
  ],
  "dependencies": [],
  "allowedImports": ["__future__", "collections.abc", "csv", "dataclasses", "datetime", "decimal", "enum", "hashlib", "io", "re", "talli_backend.shared.kernel", "typing", "unicodedata", "uuid"],
  "forbiddenResponsibilities": [
    "Ledger accounts, entry lines, balance enforcement, posting policy, or period locks",
    "Provider-triggered accounting writes or provider-specific types in the public contract",
    "FastAPI, Pydantic, Supabase, PostgreSQL, or web transport types in the public contract",
    "Authentication, company membership, investment, governance, tax, or filing policy"
  ],
  "tests": {
    "contract": "apps/backend/tests/test_banking_public_contract.py",
    "policy": "apps/backend/tests/test_banking.py",
    "architecture": "tests/architecture_foundation.test.mjs"
  },
  "compatibilityExceptions": []
}
