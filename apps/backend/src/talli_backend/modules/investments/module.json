{
  "schemaVersion": "1.0",
  "kind": "backend-capability",
  "name": "investments",
  "path": "apps/backend/src/talli_backend/modules/investments",
  "owner": "backend:investments",
  "purpose": "Own supported share-purchase, share-sale, and received-dividend policy, canonical investment positions and activity, immutable acquisition lots, authoritative FIFO allocations, deterministic tax facts, command replay, and purpose-specific investment queries.",
  "documentation": "apps/backend/src/talli_backend/modules/investments/MODULE.md",
  "publicEntryPoint": "talli_backend.modules.investments.public",
  "exports": {
    "commands": ["InvestmentsCommand", "InvestmentsCommands", "RecordReceivedDividendCommand", "RecordSharePurchaseCommand", "RecordShareSaleCommand"],
    "queries": ["AcquisitionLotPage", "AcquisitionLotView", "InvestmentActivityPage", "InvestmentActivityView", "InvestmentPositionPage", "InvestmentPositionView", "InvestmentsQueries", "PreparedReceivedDividend", "PreparedSharePurchase", "PreparedShareSale", "RecordedReceivedDividend", "RecordedSharePurchase", "RecordedShareSale", "ShareSaleAllocationPage", "ShareSaleAllocationView"],
    "events": [],
    "errors": ["InvestmentsError", "InvestmentsErrorCode"],
    "identifiers": ["AccountingEntryReference", "AcquisitionLotId", "InvestmentActionId", "InvestmentActivityKind", "InvestmentCursor", "InvestmentDocumentStatus", "InvestmentKind", "InvestmentLotHistoryStatus", "InvestmentPositionId", "InvestmentSourceReference", "InvestmentTaxTreatment", "InvestmentsPersistence", "ShareSaleAllocationId", "investments_persistence_adapter"]
  },
  "owns": {
    "postgresSchemas": ["investments"],
    "tables": ["investments.acquisition_lots", "investments.positions", "investments.received_dividends", "investments.share_purchases", "investments.share_sale_allocations", "investments.share_sales"],
    "storageBuckets": [],
    "projections": [],
    "migrations": "supabase/migrations/20260831124939_investments_capability.sql"
  },
  "ports": [
    {
      "name": "InvestmentsPersistence",
      "direction": "outbound",
      "contract": "talli_backend.modules.investments.public.InvestmentsPersistence",
      "registrationDecorator": "talli_backend.modules.investments.public.investments_persistence_adapter",
      "adapters": ["talli_backend.adapters.supabase_investments.SupabaseInvestmentsSession"]
    }
  ],
  "dependencies": [],
  "allowedImports": ["__future__", "collections.abc", "dataclasses", "decimal", "enum", "re", "talli_backend.shared.kernel", "typing", "uuid"],
  "forbiddenResponsibilities": [
    "Ledger accounts, posting lines, balance enforcement, or period-lock policy",
    "Bank-provider selection, credentials, consent, live calls, or provider-specific types",
    "FastAPI, Pydantic, Supabase, PostgreSQL, or web transport types in the public contract",
    "Company tax filing, document, governance, authority submission, or archive policy",
    "Service-role access, RLS bypass, direct browser persistence, or a second investment writer"
  ],
  "tests": {
    "contract": "apps/backend/tests/test_investments_public_contract.py",
    "policy": "apps/backend/tests/test_investments.py",
    "workflow": "apps/backend/tests/test_investments_workflow.py",
    "adapter": "apps/backend/tests/test_supabase_investments.py",
    "database": "tests/investments_database_runtime.test.mjs",
    "architecture": "tests/architecture_foundation.test.mjs"
  },
  "compatibilityExceptions": []
}
