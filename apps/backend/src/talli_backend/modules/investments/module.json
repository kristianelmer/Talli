  "exports": {
    "commands": ["InvestmentsCommand", "InvestmentsCommands", "RecordSharePurchaseCommand", "RecordShareSaleCommand"],
    "queries": ["AcquisitionLotPage", "AcquisitionLotView", "InvestmentPositionPage", "InvestmentPositionView", "InvestmentsQueries", "PreparedSharePurchase", "PreparedShareSale", "RecordedSharePurchase", "RecordedShareSale"],
    "events": [],
    "errors": ["InvestmentsError", "InvestmentsErrorCode"],
    "identifiers": ["AccountingEntryReference", "AcquisitionLotId", "InvestmentActionId", "InvestmentCursor", "InvestmentDocumentStatus", "InvestmentKind", "InvestmentLotHistoryStatus", "InvestmentPositionId", "InvestmentSourceReference", "InvestmentTaxTreatment", "InvestmentsPersistence", "investments_persistence_adapter"]
  },
  "owns": {
    "postgresSchemas": ["investments"],
    "tables": ["investments.acquisition_lots", "investments.positions", "investments.share_purchases", "investments.share_sale_allocations", "investments.share_sales"],
    "storageBuckets": [],
    "projections": [],
    "migrations": "supabase/migrations/20260831124939_investments_capability.sql"
  },
  "ports": [
    {
      "name": "InvestmentsPersistence",
      "direction": "outbound",
      "contract": "talli_backend.modules.investments.public.InvestmentsPersistence",
      "registrationDecorator": "talli_backend.modules.investments.public.investments_persistence_adapter",
      "adapters": ["talli_backend.adapters.supabase_investments.SupabaseInvestmentsSession"]
    }
  ],
  "dependencies": [],
  "allowedImports": ["__future__", "collections.abc", "dataclasses", "enum", "re", "talli_backend.shared.kernel", "typing", "uuid"],
  "forbiddenResponsibilities": [
    "Ledger accounts, posting lines, balance enforcement, or period-lock policy",
    "Bank-provider selection, credentials, consent, live calls, or provider-specific types",
