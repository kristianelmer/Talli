{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://talli.no/schemas/architecture/module.schema.json",
  "title": "Talli module manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "name",
    "path",
    "owner",
    "purpose",
    "documentation",
    "publicEntryPoint",
    "dependencies",
    "forbiddenResponsibilities",
    "tests",
    "compatibilityExceptions"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "enum": ["backend-capability", "web-feature"] },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "path": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "documentation": { "type": "string", "pattern": "MODULE\\.md$" },
    "publicEntryPoint": { "type": "string", "minLength": 1 },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "kind", "imports"],
        "properties": {
          "module": { "type": "string" },
          "kind": { "enum": ["query", "event", "feature"] },
          "imports": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "forbiddenResponsibilities": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "tests": {
      "type": "object",
      "required": ["architecture"],
      "properties": {
        "unit": { "type": "string" },
        "contract": { "type": "string" },
        "feature": { "type": "string" },
        "architecture": { "type": "string" }
      },
      "additionalProperties": false
    },
    "compatibilityExceptions": {
      "type": "array",
      "items": { "type": "string", "pattern": "^compat-" }
    },
    "exports": {
      "type": "object",
      "properties": {
        "commands": { "$ref": "#/$defs/stringArray" },
        "queries": { "$ref": "#/$defs/stringArray" },
        "events": { "$ref": "#/$defs/stringArray" },
        "errors": { "$ref": "#/$defs/stringArray" },
        "identifiers": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "owns": {
      "type": "object",
      "required": ["postgresSchemas", "tables", "storageBuckets", "projections", "migrations"],
      "properties": {
        "postgresSchemas": { "$ref": "#/$defs/stringArray" },
        "tables": { "$ref": "#/$defs/stringArray" },
        "storageBuckets": { "$ref": "#/$defs/stringArray" },
        "projections": { "$ref": "#/$defs/stringArray" },
        "migrations": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "direction", "adapters"],
        "properties": {
          "name": { "type": "string" },
          "direction": { "const": "outbound" },
          "adapters": { "$ref": "#/$defs/stringArray" }
        },
        "additionalProperties": false
      }
    },
    "ownedRoutes": { "$ref": "#/$defs/stringArray" },
    "apiOperations": { "$ref": "#/$defs/stringArray" },
    "cachePolicy": {
      "type": "object",
      "required": ["default", "allowed"],
      "properties": {
        "default": { "const": "no-store" },
        "allowed": { "$ref": "#/$defs/stringArray" }
      },
      "additionalProperties": false
    },
    "directBrowserFlows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "scope", "reviewCondition"],
        "properties": {
          "name": { "type": "string" },
          "scope": { "type": "string" },
          "reviewCondition": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "backend-capability" } } },
      "then": {
        "required": ["exports", "owns", "ports"],
        "properties": {
          "path": {
            "pattern": "^apps/backend/src/talli_backend/modules/[a-z][a-z0-9_]*$"
          },
          "publicEntryPoint": {
            "pattern": "^talli_backend\\.modules\\.[a-z][a-z0-9_]*\\.public$"
          },
          "dependencies": {
            "items": {
              "properties": {
                "kind": { "enum": ["query", "event"] }
              }
            }
          },
          "tests": {
            "required": ["unit", "contract", "architecture"]
          }
        },
        "not": {
          "anyOf": [
            { "required": ["ownedRoutes"] },
            { "required": ["apiOperations"] },
            { "required": ["cachePolicy"] },
            { "required": ["directBrowserFlows"] }
          ]
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "web-feature" } } },
      "then": {
        "required": ["ownedRoutes", "apiOperations", "cachePolicy", "directBrowserFlows"],
        "properties": {
          "path": {
            "pattern": "^apps/web/features/[a-z][a-z0-9-]*$"
          },
          "publicEntryPoint": {
            "pattern": "^@/features/[a-z][a-z0-9-]*$"
          },
          "dependencies": {
            "items": {
              "properties": {
                "kind": { "const": "feature" }
              }
            }
          },
          "tests": {
            "required": ["feature", "architecture"]
          }
        },
        "not": {
          "anyOf": [
            { "required": ["exports"] },
            { "required": ["owns"] },
            { "required": ["ports"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
